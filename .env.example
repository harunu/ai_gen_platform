# ============================================================
# ai_gen_platform — Environment Variables Reference
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_NAME=ai_gen_platform
APP_VERSION=1.0.0
APP_ENV=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# API Key for protected AI endpoints (X-API-Key header)
API_KEY=dev-api-key-change-in-production

# CORS: comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- LLM Configuration ---
# USE_MOCK_LLM=true means NO real LLM is called — safe for local dev and CI
USE_MOCK_LLM=true

# Only needed when USE_MOCK_LLM=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2   # Free local model via sentence-transformers
EMBEDDING_BATCH_SIZE=32

# --- ChromaDB ---
CHROMA_HOST=chroma                  # Docker service name (resolves in compose network)
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=documents

# --- RAG Pipeline ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5
SIMILARITY_THRESHOLD=0.3

# --- Rate Limiting ---
RATE_LIMIT_AI=10/minute             # AI endpoints
RATE_LIMIT_HEALTH=60/minute         # Health endpoints

# --- Agent ---
AGENT_MAX_STEPS=5
AGENT_MEMORY_TURNS=10
